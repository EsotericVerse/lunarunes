{
  "name": "lrs",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "lo3r@lrs LunaRunes: rune, boardgame, card, daily independently exported modules",
  "scripts": {
    "dev:web": "vite --config web/vite.config.mjs",
    "build:web": "vite build --config web/vite.config.mjs",
    "preview:web": "vite preview --config web/vite.config.mjs",
    "build:cloudflare": "npm run check:syntax && npm run check:files && npm run build:lrs:assets && npm run build:web && node scripts/assemble-rune-cloudflare.mjs",
    "deploy:cloudflare": "wrangler deploy",
    "build:lrs:assets": "node scripts/prepare-lrs-release-assets.mjs",
    "effects:prepare": "node scripts/prepare-rune-runtime-assets.mjs",
    "artifacts:web:art": "node scripts/build-rune-artifacts.mjs --target=web --art-only",
    "artifacts:ios:art": "node scripts/build-rune-artifacts.mjs --target=ios --art-only",
    "artifacts:web": "node scripts/build-rune-artifacts.mjs --target=web",
    "artifacts:ios": "node scripts/build-rune-artifacts.mjs --target=ios",
    "check:syntax": "node --check index.mjs && node --check public-rune-read.mjs && node --check lrs-database.mjs && node --check modules/lrs/card/draw-core.mjs && node --check scripts/assemble-rune-cloudflare.mjs",
    "check:files": "node scripts/check-lrs-file-count.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "sharp": "0.35.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "motion": "13.4.4",
    "three": "0.187.0",
    "wrangler": "^4.148.0"
  },
  "exports": {
    ".": "./modules/lrs/index.mjs",
    "./rune": "./modules/lrs/rune/index.mjs",
    "./card": "./modules/lrs/card/index.mjs",
    "./boardgame": "./modules/lrs/boardgame/index.mjs",
    "./daily": "./modules/lrs/daily/index.mjs",
    "./boardgame/ui": "./modules/lrs/boardgame/ui.mjs"
  },
  "dependencies": {
    "kysely": "0.29.8",
    "pg": "8.23.1"
  }
}
