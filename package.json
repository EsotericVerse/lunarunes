{
  "name": "lrune",
  "version": "0.1.0-migration",
  "private": true,
  "type": "module",
  "description": "Independent Rune engine and asset production; standalone web site migration in progress",
  "scripts": {
    "art:verify": "node scripts/build-rune-artifacts.mjs --target=web --art-only --verify-only",
    "artifacts:web:art": "node scripts/build-rune-artifacts.mjs --target=web --art-only",
    "artifacts:ios:art": "node scripts/build-rune-artifacts.mjs --target=ios --art-only",
    "effects:prepare": "node scripts/prepare-rune-runtime-assets.mjs",
    "artifacts:web": "node scripts/build-rune-artifacts.mjs --target=web",
    "artifacts:ios": "node scripts/build-rune-artifacts.mjs --target=ios",
    "dev:web": "vite --config web/vite.config.mjs",
    "build:web": "vite build --config web/vite.config.mjs",
    "preview:web": "vite preview --config web/vite.config.mjs",
    "check:lrune:core": "node --test tests/lrune-core.test.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "motion": "13.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8"
  }
}
