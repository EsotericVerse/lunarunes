{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunarunes",
  "main": "./index.mjs",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist/pages",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "workers_dev": false,
  "preview_urls": true,
  "hyperdrive": [
    {
      "binding": "LRS_HYPERDRIVE",
      "id": "ad545e80146e4737a3f511c3ea3841f1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LRS_GAME_ROOMS",
        "class_name": "LrsGameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "lrs-game-room-v1",
      "new_sqlite_classes": [
        "LrsGameRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
