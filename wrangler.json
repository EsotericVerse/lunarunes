{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lunarunes",
  "main": "./index.mjs",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./dist/pages",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {},
  "workers_dev": false,
  "preview_urls": true,
  "hyperdrive": [
    {
      "binding": "LRS_HYPERDRIVE",
      "id": "ad545e80146e4737a3f511c3ea3841f1"
    }
  ]
}
